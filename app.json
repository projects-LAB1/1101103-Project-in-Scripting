{
  "expo": {
    "name": "myproj",
    "slug": "myproj",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.papon254.myproj"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "owner": "papon254",
    "plugins": [
      "expo-notifications"
    ]
  }
}
